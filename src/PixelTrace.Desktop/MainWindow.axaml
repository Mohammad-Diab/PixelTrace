<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ins="using:Insiyab.Avalonia.Controls" xmlns:vm="using:PixelTrace.Desktop.ViewModels"
        xmlns:local="using:PixelTrace.Desktop.Controls"
        x:Class="PixelTrace.Desktop.MainWindow" x:DataType="vm:MainViewModel"
        Title="PixelTrace" Width="1240" Height="860" MinWidth="960" MinHeight="700"
        FlowDirection="{Binding Direction}" Icon="/Assets/pixeltrace.ico"
        WindowStartupLocation="CenterScreen" ins:TitleBar.Extends="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Classes="topbar" ins:TitleBar.IsDragArea="True">
      <Grid ColumnDefinitions="*,Auto,*,Auto">
        <StackPanel Classes="zone start">
          <Border x:Name="BrandPill" Classes="island brand" IsVisible="True" Height="{DynamicResource InsAppbarH}" ins:TitleBar.IsSystemMenuArea="True">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <ins:Icon Data="{StaticResource IconSearch}" Size="20" Foreground="{DynamicResource InsPrimary}" />
              <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Center">
                <TextBlock x:Name="AppName" Text="PixelTrace" FontSize="15" FontWeight="Bold" />
                <TextBlock x:Name="AppDescription" Text="{Binding Text[Description]}" Classes="muted" FontSize="9" FontWeight="Normal" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Classes="zone end">
          <Button x:Name="LanguageButton" Classes="island" Content="{Binding Text[Language]}" Click="LanguageClick" FontSize="12" />
          <ins:DayNight x:Name="ThemeButton" AutomationProperties.Name="{Binding Text[Theme]}" />
        </StackPanel>
        <ins:CaptionButtons x:Name="WindowCaptions" Grid.Column="3" />
      </Grid>
    </Border>

    <ins:Toolbar Grid.Row="1" Classes="plain" Margin="20,2,20,12">
      <ins:ToolbarButton x:Name="OpenButton" Label="{Binding Text[Open]}" Icon="{StaticResource IconFolder}" ShowLabel="True" HotKey="Ctrl+O" Click="OpenClick" IsEnabled="{Binding CanOpen}" />
      <ins:ToolbarButton x:Name="ReanalyzeButton" Label="{Binding Text[Reanalyze]}" Icon="{StaticResource IconSearch}" ShowLabel="True" HotKey="F5" Click="ReanalyzeClick" IsVisible="{Binding HasImage}" IsEnabled="{Binding CanAnalyze}" />
      <Button Classes="ghost-danger sm" Content="{Binding Text[Cancel]}" Click="CancelClick" IsVisible="{Binding IsBusy}" />
      <ins:ToolbarButton x:Name="SaveButton" Label="{Binding Text[Save]}" Icon="{StaticResource IconDownload}" ShowLabel="True" HotKey="Ctrl+S" Click="SaveClick" IsVisible="{Binding ShowSave}" IsEnabled="{Binding CanSave}" ins:Toolbar.AtEnd="True" />
    </ins:Toolbar>

    <Grid Grid.Row="2" x:Name="Workspace" ColumnDefinitions="*,16,240" Margin="20,0,20,12">
      <Border x:Name="ImagePanel" Classes="panel low" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Border Classes="panel-head" Padding="14,10" IsVisible="{Binding HasImage}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding FileName}" MaxWidth="360" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" ins:TextDirection.IsAuto="True" ToolTip.Tip="{Binding FileName}" />
                <Button x:Name="CompareButton" Content="{Binding Text[ShowOriginal]}" Classes="sm" Classes.primary="{Binding IsShowingOriginal}" Classes.secondary="{Binding !IsShowingOriginal}" IsEnabled="{Binding CanCompare}" ToolTip.Tip="{Binding Text[HoldTip]}" />
              </StackPanel>
              <TextBlock Text="{Binding FileDetails}" Classes="muted num" FontSize="10" FlowDirection="LeftToRight" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource InsWash1}">
            <Grid>
              <local:ImageViewport x:Name="Viewer" Source="{Binding DisplayImage}" ReviewBounds="{Binding ReviewBounds}" FlowDirection="LeftToRight" AutomationProperties.Name="Image inspection canvas" />
              <StackPanel IsVisible="{Binding !HasImage}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" IsHitTestVisible="False">
                <ins:Icon Data="{StaticResource IconFolder}" Size="30" Foreground="{DynamicResource InsToneBrandSoft}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Text[Empty]}" FontSize="16" HorizontalAlignment="Center" />
              </StackPanel>
              <Border Classes="card" IsVisible="{Binding MethodUnavailable}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="12,7"><TextBlock Text="{Binding Text[JpegOnly]}" FontSize="12" /></Border>
              <ins:LoadingSpinner Classes="sm" IsVisible="{Binding IsRendering}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" />
            </Grid>
          </Border>
          <local:AnalysisSummaryView x:Name="SummaryPanel" Grid.Row="2" IsVisible="{Binding HasResults}" />
          <Border Grid.Row="3" Classes="panel-foot" Padding="14,10">
            <StackPanel Spacing="3">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Text[Legend]}" FontWeight="SemiBold" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Text[LegendNote]}" Classes="muted" FontSize="10" /></Grid>
              <StackPanel FlowDirection="LeftToRight">
                <local:HeatmapLegend x:Name="Legend" Height="22" Score="{Binding HoverIntensity}" Sensitivity="{Binding Sensitivity}" />
                <Grid ColumnDefinitions="*,*,*"><TextBlock Text="{Binding Text[Low]}" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding Text[Medium]}" FontSize="10" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Text[High]}" FontSize="10" HorizontalAlignment="Right" /></Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="DisplayPanel" Grid.Column="2" Classes="panel low">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" Spacing="19">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock x:Name="DisplayTitle" Text="{Binding Text[Display]}" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="DefaultButton" Grid.Column="1" Classes="ghost sm" Content="{Binding Text[Default]}" Click="DefaultClick" IsEnabled="{Binding CanAdjust}" ToolTip.Tip="{Binding Text[DefaultTip]}" /></Grid>
            <StackPanel Classes="field" IsVisible="{Binding HasResults}">
              <TextBlock Text="{Binding Text[Result]}" Classes="label" FontSize="11" />
              <ComboBox x:Name="ResultSelector" Classes="sm" ItemsSource="{Binding AvailableMethods}" SelectedItem="{Binding SelectedResult}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanAdjust}" AutomationProperties.Name="{Binding Text[Result]}" />
            </StackPanel>
            <StackPanel Spacing="6" IsEnabled="{Binding CanAdjust}">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Text[Sensitivity]}" Classes="label" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding SensitivityValue}" Classes="muted num" FontSize="11" FlowDirection="LeftToRight" /></Grid>
              <StackPanel FlowDirection="LeftToRight"><Slider x:Name="SensitivitySlider" Minimum="0.4" Maximum="2.5" Value="{Binding Sensitivity}" SmallChange="0.05" AutomationProperties.Name="{Binding Text[Sensitivity]}" /><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding Text[SensitivityLow]}" Classes="muted" FontSize="9" /><TextBlock Grid.Column="1" Text="{Binding Text[SensitivityHigh]}" Classes="muted" FontSize="9" HorizontalAlignment="Right" /></Grid></StackPanel>
            </StackPanel>
            <StackPanel Spacing="6" IsEnabled="{Binding CanAdjust}">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Text[Opacity]}" Classes="label" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding OpacityValue}" Classes="muted num" FontSize="11" FlowDirection="LeftToRight" /></Grid>
              <StackPanel FlowDirection="LeftToRight"><Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="{Binding Opacity}" SmallChange="0.05" AutomationProperties.Name="{Binding Text[Opacity]}" /><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding Text[Original]}" Classes="muted" FontSize="9" /><TextBlock Grid.Column="1" Text="{Binding Text[Overlay]}" Classes="muted" FontSize="9" HorizontalAlignment="Right" /></Grid></StackPanel>
            </StackPanel>
            <Separator />
            <StackPanel Spacing="9" IsEnabled="{Binding HasImage}">
              <TextBlock Text="{Binding Text[Zoom]}" Classes="label" FontSize="12" />
              <Grid ColumnDefinitions="Auto,*,Auto" FlowDirection="LeftToRight"><Button Classes="ghost icon sm" Click="ZoomOutClick" AutomationProperties.Name="{Binding Text[ZoomOut]}"><ins:Icon Data="{StaticResource InsPictureZoomOut}" Size="17" /></Button><TextBlock x:Name="ViewZoom" Grid.Column="1" Text="—" Classes="muted num" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="12" /><Button Grid.Column="2" Classes="ghost icon sm" Click="ZoomInClick" AutomationProperties.Name="{Binding Text[ZoomIn]}"><ins:Icon Data="{StaticResource InsPictureZoomIn}" Size="17" /></Button></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Classes="secondary sm" Content="{Binding Text[Fit]}" Click="FitClick" HorizontalAlignment="Stretch" /><Button Grid.Column="1" Classes="secondary sm" Content="{Binding Text[Actual]}" Click="ActualClick" HorizontalAlignment="Stretch" /></Grid>
            </StackPanel>
            <TextBlock Text="{Binding MethodDescription}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasResults}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3">
      <Border Classes="card" IsVisible="{Binding HasError}" Margin="20,0,20,8" Padding="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ErrorText}" ToolTip.Tip="{Binding Error}" FontSize="12" Foreground="{DynamicResource InsToneBad}" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="close sm" Click="DismissErrorClick" ToolTip.Tip="{Binding Text[Dismiss]}" /></Grid></Border>
      <ProgressBar IsVisible="{Binding IsBusy}" Value="{Binding Progress}" Height="3" Classes="sm" AutomationProperties.Name="{Binding Text[AnalysisProgress]}" />
      <Grid ColumnDefinitions="*,Auto" Margin="22,0,22,10"><TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding PixelReadout}" Classes="muted num" FontSize="10" IsVisible="{Binding HasImage}" FlowDirection="LeftToRight" /></Grid>
    </StackPanel>
  </Grid>
</Window>
