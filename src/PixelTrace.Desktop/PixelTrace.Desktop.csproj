<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/pixeltrace.ico</ApplicationIcon>
    <AssemblyName>PixelTrace</AssemblyName>
    <Version>1.3.1</Version>
    <Description>Offline digital image forensics workbench</Description>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/pixeltrace.ico" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../PixelTrace.Core/PixelTrace.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Insiyab.Avalonia" Version="0.3.2" />
  </ItemGroup>
</Project>
