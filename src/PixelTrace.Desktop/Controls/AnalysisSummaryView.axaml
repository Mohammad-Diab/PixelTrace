<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelTrace.Desktop.ViewModels"
             x:Class="PixelTrace.Desktop.Controls.AnalysisSummaryView" x:DataType="vm:MainViewModel">
  <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,10" Spacing="5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Text[Summary]}" Classes="muted" FontSize="10" />
          <TextBlock x:Name="SummaryStatus" Text="{Binding SummaryStatus}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding Text[ClearRegion]}" Classes="ghost sm" Click="ClearClick" IsVisible="{Binding HasReviewRegion}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding SummaryDescription}" FontSize="11" TextWrapping="Wrap" />
      <ItemsControl x:Name="RegionList" ItemsSource="{Binding SummaryRegions}" IsEnabled="{Binding CanAdjust}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SummaryRegionItem">
            <Button Classes="secondary sm" Width="176" Margin="0,3,8,3" Padding="10,7" HorizontalContentAlignment="Stretch"
                    Tag="{Binding}" Click="RegionClick" ToolTip.Tip="{Binding BoundsLabel}" AutomationProperties.Name="{Binding Title}">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding SummaryScope}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Text[SummaryCauses]}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Text[SummaryLimit]}" FontSize="10" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
